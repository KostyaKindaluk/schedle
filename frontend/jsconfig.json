{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["DOM", "ESNext"],
		"jsx": "react-jsx",
		"checkJs": true,
		"baseUrl": "./",
		"paths": {
      "@src/*": ["src/*"],
			"@styles/*": ["styles/*"],
			"@assets/*": ["assets/*"]
    }
	},
	"include": ["src/**/*", "stlyes/**/*", "assets/**/*"],
	"exclude": ["node_modules"]
}